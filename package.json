{
  "name": "t3-discord-presence",
  "version": "1.0.0",
  "description": "Discord Rich Presence for T3 Code agent activity",
  "type": "module",
  "bin": {
    "t3-discord-presence": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts run --debug",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepack": "npm run check && npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f3tchcodes/t3-discord-presence.git"
  },
  "bugs": {
    "url": "https://github.com/f3tchcodes/t3-discord-presence/issues"
  },
  "homepage": "https://github.com/f3tchcodes/t3-discord-presence#readme",
  "keywords": [
    "t3-code",
    "discord",
    "rich-presence"
  ],
  "author": "f3tch",
  "license": "MIT",
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "effect": "4.0.0-beta.103"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.10.0",
    "eslint": "^10.8.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
